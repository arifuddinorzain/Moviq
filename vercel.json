{
  "version": 2,
  "functions": {
    "api.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "index.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "watch.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/api.php",
      "dest": "/api.php"
    },
    {
      "src": "/watch.php",
      "dest": "/watch.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
